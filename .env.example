# ===== 应用配置 =====
DEBUG=false
API_V1_PREFIX=/api/v1

# ===== 数据库（生产推荐 PostgreSQL）=====
# 开发零依赖：sqlite+aiosqlite:///./research_agent.db
# 生产：postgresql+asyncpg://postgres:postgres@db:5432/research_agent
DATABASE_URL=sqlite+aiosqlite:///./research_agent.db

# ===== 数据库迁移 =====
# 启动时是否自动执行 alembic upgrade head
# false=显式迁移（CI/CD 中执行 alembic upgrade）；true=启动即迁移。
# 注意：迁移失败会直接启动失败（不再用 create_all 兜底），避免 schema 漂移
MIGRATION_ON_STARTUP=false

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 缓存后端（memory 单实例 / redis 多实例）=====
CACHE_BACKEND=memory
CACHE_KEY_PREFIX=rap:
CACHE_DEFAULT_TTL=1800
CACHE_MAX_SIZE=10000
LLM_CACHE_TTL=600

# ===== 限流后端（memory / redis）=====
RATE_LIMIT_BACKEND=memory
# 是否对科研域（LLM 生成类）端点启用按用户套餐限流
RATE_LIMIT_API_ENABLED=true
RATE_LIMIT_FALLBACK=allow

# ===== 请求体限制 =====
MAX_REQUEST_BODY_BYTES=2000000
MAX_CONTENT_LENGTH=500000

# ===== JWT / 安全 =====
# 生产必须替换为随机值（至少 16 字符）：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet 密钥，用于加密用户 API Key：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# ===== 登录防护 =====
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_RATE_LIMIT=20

# ===== LLM 配置 =====
# 模式: remote (远程API) / ascend (本地昇腾NPU)
LLM_MODE=remote
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ===== 昇腾 NPU LLM =====
ASCEND_VLLM_BASE_URL=http://127.0.0.1:8001/v1
ASCEND_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
ASCEND_VLLM_TIMEOUT=120.0
ASCEND_TP_SIZE=4
ASCEND_MAX_MODEL_LEN=8192

# ===== Embedding =====
# 模式: remote / ascend_api / ascend_local
EMBEDDING_MODE=remote
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-ada-002
ASCEND_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
ASCEND_EMBEDDING_LOCAL=false
ASCEND_EMBEDDING_DEVICE=0

# ===== 昇腾 NPU 高级 =====
ASCEND_RT_VISIBLE_DEVICES=
ASCEND_ENABLE_ACL_GRAPH=true
ASCEND_TASK_QUEUE_ENABLE=1
ASCEND_CPU_AFFINITY=0
ASCEND_ALLOC_CONF=expandable_segments

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== 计费 =====
BILLING_API_KEY=

# ===== CORS（生产必须显式配置，不可用 *）=====
CORS_ORIGINS=[]
